# =============================================================================
# AIX OS — .gitignore
# Защита приватных данных, кеша и системных файлов
# =============================================================================

# =============================================================================
# КРИТИЧНО: приватные ключи и кошельки
# НИКОГДА не публикуй эти файлы — иначе потеряешь все средства
# =============================================================================
data/wallets/
data/wallets/*.json
*.wallet
*.wallet.json
*.key
*.priv
*.pem
*.seed
seed.txt
mnemonic.txt

# =============================================================================
# Данные блокчейна (личные для каждой ноды)
# =============================================================================
data/
!data/wallets/README.md
data/*.json
data/chain*.json
data/chain*.db
data/chain*.json.bak
data/poc_*.json
data/swap_*.json
data/sbt_*.json
data/gifts_*.json
data/timelocks_*.json
data/inheritance_*.json
data/ids_*.json
data/burn_*.json
data/contacts_*.json
data/peers_*.json
data/dao_*.json
data/faucet_*.json
data/ai_memory.json
data/*.tmp
data/*.bak

# =============================================================================
# Бэкапы (личные данные)
# =============================================================================
data_backup*
*_backup.json
*_backup/
*_broken_backup*
*.backup
*.bak
*.bak2
*.bak3
*.bak4
*.bak5

# =============================================================================
# Логи, дампы, отладка
# =============================================================================
*.log
logs/
debug_*.txt
debug_*.log
AIX_OS_FULL_DUMP.txt
SESSION_LOG.txt
AI_BRIEF.md
AI_BRIEF.json
AI_BRIEF_FULL.md
CONTEXT_UPDATE.md

# =============================================================================
# QR-коды и личные картинки (но НЕ иконки сайта)
# =============================================================================
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.ico
# Исключения — иконки лендинга, промо, README
!web/landing/*.svg
!web/landing/*.png
!web/landing/*.ico
!web/assets/*.png
!web/assets/*.svg
!brand/*.png
!brand/*.jpg
!brand/*.svg
!docs/*.png
!docs/*.jpg
!docs/*.svg
!docs/promo.mp4
!docs/promo_poster.png
!README*.png
!mobile/flutter_app/assets/**

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# Виртуальные окружения
# =============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =============================================================================
# Тесты и покрытие
# =============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# =============================================================================
# IDE и редакторы
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# =============================================================================
# OS
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Node.js
# =============================================================================
node_modules/
package-lock.json
yarn.lock
.npm
.yarn

# =============================================================================
# Flutter / Dart
# =============================================================================
mobile/flutter_app/.dart_tool/
mobile/flutter_app/build/
mobile/flutter_app/.flutter-plugins
mobile/flutter_app/.flutter-plugins-dependencies
mobile/flutter_app/.packages
mobile/flutter_app/pubspec.lock
mobile/flutter_app/ios/Pods/
mobile/flutter_app/android/.gradle/
mobile/flutter_app/android/app/build/
mobile/flutter_app/android/local.properties
mobile/flutter_app/windows/flutter/ephemeral/
mobile/flutter_app/linux/flutter/ephemeral/
mobile/flutter_app/macos/Flutter/ephemeral/
mobile/flutter_app/e2e_out/

# =============================================================================
# Tauri (десктоп)
# =============================================================================
desktop/tauri_app/target/
desktop/tauri_app/Cargo.lock

# =============================================================================
# Переменные окружения и секреты
# =============================================================================
.env
.env.local
.env.*.local
*.secret
secrets/
!.env.example
config_local.py
config.local.py

# =============================================================================
# Docker
# =============================================================================
.dockerignore
*.pid

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/

# =============================================================================
# AIX OS специфика
# =============================================================================
test_*.py
*_test.py
!tests/test_*.py
# === AIX OS: Строительные скрипты (не публиковать) ===
scripts/patch_*.py
scripts/fix_*.py
scripts/build_apk.py
scripts/create_multi_pools.py
scripts/update_readme.py
scripts/cleanup_git_scripts.py
data/
messenger_context*.txt
# AIX OS — не пушим в репо
pub_cache/
data/token_registry.json
data/swap_*.json
data/messenger.json
data/ai_memory.json
project_tree.txt
patch_*.py
scripts/fix*.py
scripts/cleanup_tokens.py
AI_BRIEF.json
AI_BRIEF_FULL.md
AIX_OS_FULL_DUMP.txt

# Vesting private key — NEVER commit
data/aix_dev_key.json

# =============================================================================
# AIX OS — session scripts, backups, binaries (DO NOT COMMIT)
# =============================================================================
_[!_]*.py
*.bak_*
*.tar.gz
build_apk_output.txt
project-tree.txt
